          { "@type": "Question", "name": "Where can I book reformer Pilates in Abuja?", "acceptedAnswer": { "@type": "Answer", "text": "Balance_ee schedules reformer Pilates sessions in Abuja by enquiry through WhatsApp." } },
          { "@type": "Question", "name": "Does balance_ee offer tower Pilates in Abuja?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Tower Pilates sessions can be scheduled with balance_ee through WhatsApp." } },
          { "@type": "Question", "name": "What is the Just Move Series?", "acceptedAnswer": { "@type": "Answer", "text": "Just Move is a three-part movement education webinar series from balance_ee running from September to November 2026." } }
