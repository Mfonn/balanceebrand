        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Abuja",
          "addressRegion": "FCT",
          "addressCountry": "NG"
        },
        "areaServed": [
          { "@type": "City", "name": "Abuja" },
          { "@type": "AdministrativeArea", "name": "Federal Capital Territory" }
